PORT=8787

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only needed if your key is account-level rather than workspace-scoped —
# Anthropic will return a 400 asking for this header; find the workspace ID
# in the Console URL when viewing that workspace (console.anthropic.com/settings/workspaces)
ANTHROPIC_WORKSPACE_ID=

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must match one of the "Authorization Callback Domain" values on your Strava API app
STRAVA_REDIRECT_URI=http://localhost:8787/api/strava/callback

# Where the browser lands after connect/disconnect completes
APP_URL=http://localhost:5173
