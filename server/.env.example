PORT=8787

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must match one of the "Authorization Callback Domain" values on your Strava API app
STRAVA_REDIRECT_URI=http://localhost:8787/api/strava/callback

# Where the browser lands after connect/disconnect completes
APP_URL=http://localhost:5173
